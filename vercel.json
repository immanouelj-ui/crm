{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://crm-pro-backend.fly.dev/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/push-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
